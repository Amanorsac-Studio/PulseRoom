{
  "name": "pulseroom",
  "productName": "PulseRoom",
  "version": "1.2.0",
  "description": "Reverb & delay time calculator with EQ, compression and mixing guides for music producers",
  "main": "main.js",
  "author": "PulseRoom",
  "license": "MIT",
  "scripts": {
    "start": "node start.js",
    "dist:win": "node node_modules/electron-builder/cli.js --win",
    "dist:mac": "node node_modules/electron-builder/cli.js --mac",
    "build:www": "node build-www.js",
    "cap:android": "node build-www.js && node node_modules/@capacitor/cli/bin/capacitor sync android",
    "cap:ios": "node build-www.js && node node_modules/@capacitor/cli/bin/capacitor sync ios"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "ffmpeg-static": "^5.3.0",
    "geist": "^1.7.2"
  },
  "build": {
    "appId": "com.amanorsac.pulseroom",
    "productName": "PulseRoom",
    "files": [
      "main.js",
      "index.html",
      "styles.css",
      "ask.css",
      "answers.js",
      "app.js",
      "ask.js",
      "icon.png",
      "fonts/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "artifactName": "${productName}-${version}-Windows.${ext}",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "icon.png",
      "artifactName": "${productName}-${version}-macOS-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": {
        "teamId": "SGQVTNFK4Q"
      }
    },
    "copyright": "Copyright (c) 2026 Amanorsac Studio",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "icon.png",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PulseRoom"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    }
  }
}