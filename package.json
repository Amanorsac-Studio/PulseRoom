{
  "name": "pulseroom",
  "productName": "PulseRoom",
  "version": "1.0.0",
  "description": "Reverb & delay time calculator with EQ, compression and mixing guides for music producers",
  "main": "main.js",
  "author": "PulseRoom",
  "license": "MIT",
  "scripts": {
    "start": "node start.js",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "build:www": "node build-www.js",
    "cap:android": "node build-www.js && npx cap sync android",
    "cap:ios": "node build-www.js && npx cap sync ios"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "ffmpeg-static": "^5.3.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0"
  },
  "build": {
    "appId": "com.pulseroom.app",
    "productName": "PulseRoom",
    "files": [
      "main.js",
      "index.html",
      "styles.css",
      "app.js",
      "icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music"
    }
  }
}
